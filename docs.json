  "redirects": [
    {
      "source": "/overview",
      "destination": "/"
    },
    {
      "source": "/getting-started",
      "destination": "/quickstart"
    },
    {
      "source": "/how-to-copy-trade",
      "destination": "/guide/copy-trading"
    },
    {
      "source": "/referrals",
      "destination": "/guide/rewards"
    }
